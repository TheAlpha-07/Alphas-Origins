{
  "type": "origins:action_over_time",
  "interval": 20,
  "rising_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:grant_power",
        "power": "alpha:hunt_camouflage",
        "source": "alpha:hunter"
      }
    ]
  },
  "falling_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:revoke_power",
        "power": "alpha:hunt_camouflage",
        "source": "alpha:hunter"
      }
    ]
  },
  "conditions": {
    "type": "origins:and",
    "conditions": [
      {
        "type": "origins:power_active",
        "power": "alpha:toggle_hunt_attack"
      },
      {
        "type": "origins:resource",
        "resource": "alpha:test",
        "comparison": "==",
        "compare_to": 1
      }
    ]
  }
}