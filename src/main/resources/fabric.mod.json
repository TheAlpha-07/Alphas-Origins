{
  "schemaVersion": 1,
  "id": "OriginsEvolved",
  "version": "${version}",
  "name": "Origins Evolved",
  "description": "Origins Evolved is an addon for the original origins mod. Origins Evolved adds an evolving system to the normal origins in the game, and the added origins with this mod.",
  "authors": [
    "TheAlpha_07"
  ],
  "contact": {
    "repo": "https://github.com/alfredmeuleman/Origins Evolved"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/OriginsEvolved/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "origins.evolved.originsevolved.client.OriginsEvolvedClient"
    ],
    "main": [
      "origins.evolved.originsevolved.OriginsEvolved"
    ]
  },
  "mixins": [
    "OriginsEvolved.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "origins": ">=1.9.0"
  }
}
