{
  "type": "origins:multiple",
  "toggle": {
    "type": "origins:toggle",
    "key": {
      "continuous": false,
      "key": "key.origins.denary_active"
    },
    "active_by_default": true
  },

  "glow": {
    "type": "origins:entity_glow",
    "bientity_condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:can_see",
          "shape_type": "visual",
          "fluid_handling": "any"
        },
        {
          "type": "origins:distance",
          "comparison": "<=",
          "compare_to": 100
        },
        {
          "type": "origins:target_condition",
          "condition": {
            "type": "origins:invisible",
            "inverted": true
          }
        }
      ]
    },

    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    },

    "use_teams": false,
    "red": 0.0,
    "green": 0.0,
    "blue": 1.0
  }
}
