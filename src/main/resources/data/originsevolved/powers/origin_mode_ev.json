{
  "type": "origins:action_over_time",
  "interval": 20,

  "rising_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:grant_power",
        "power": "originsevolved:known_origins_ev",
        "source": "originsevolved:shadow_assassin"
      },
      {
        "type": "origins:change_resource",
        "resource": "originsevolved:assassin_indicator_ev",
        "change": 3
      },
      {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Origin Mode ACTIVATED\", \"color\": \"red\"}",
        "condition": {
          "type": "origins:resource",
          "resource": "originsevolved:assassin_indicator_ev",
          "comparison": "==",
          "compare_to": 3
        }
      }
    ]
  },
  "falling_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:revoke_power",
        "power": "originsevolved:known_origins_ev",
        "source": "originsevolved:shadow_assassin"
      }
    ]
  },
  "condition": {
    "type": "origins:power_active",
    "power": "originsevolved:toggle_assassin_attack_ev"
  }
}