{
  "type": "origins:action_over_time",
  "interval": 20,

  "rising_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:grant_power",
        "power": "alpha:less_hearts",
        "source": "originsevolved:shadow_assassin"
      },
      {
        "type": "origins:grant_power",
        "power": "originsevolved:damage_dash_ev",
        "source": "originsevolved:shadow_assassin"
      },
      {
        "type": "origins:grant_power",
        "power": "alpha:no_shield",
        "source": "originsevolved:shadow_assassin"
      },
      {
        "type": "origins:grant_power",
        "power": "alpha:attack_speed",
        "source": "originsevolved:shadow_assassin"
      },
      {
        "type": "origins:grant_power",
        "power": "originsevolved:more_kinetic_assassin_ev",
        "source": "originsevolved:shadow_assassin"
      },
      {
        "type": "origins:change_resource",
        "resource": "originsevolved:assassin_indicator_ev",
        "change": 1
      },
      {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Reckless Mode ACTIVATED\", \"color\": \"green\"}",
        "condition": {
          "type": "origins:resource",
          "resource": "originsevolved:assassin_indicator_ev",
          "comparison": "==",
          "compare_to": 1
        }
      }
    ]
  },
  "falling_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:revoke_power",
        "power": "alpha:less_hearts",
        "source": "originsevolved:shadow_assassin"
      },
      {
        "type": "origins:revoke_power",
        "power": "originsevolved:damage_dash_ev",
        "source": "originsevolved:shadow_assassin"
      },
      {
        "type": "origins:revoke_power",
        "power": "alpha:no_shield",
        "source": "originsevolved:shadow_assassin"
      },
      {
        "type": "origins:revoke_power",
        "power": "alpha:attack_speed",
        "source": "originsevolved:shadow_assassin"
      },
      {
        "type": "origins:revoke_power",
        "power": "originsevolved:more_kinetic_assassin_ev",
        "source": "originsevolved:shadow_assassin"
      }
    ]
  },
  "condition": {
    "type": "origins:power_active",
    "power": "originsevolved:toggle_reckless_defensive_ev"
  }
}