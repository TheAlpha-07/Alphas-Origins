{
  "type": "origins:action_over_time",
  "interval": 200,
  "rising_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:grant_power",
        "power": "originsevolved:binding_arrow_ev",
        "source": "originsevolved:sharp_hunter"
      },
      {
        "type": "origins:change_resource",
        "resource": "oiginsevolved:hunter_indicator_ev",
        "change": 1
      },
      {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Binding Mode ACTIVATED\", \"color\": \"green\"}",
        "condition": {
          "type": "origins:resource",
          "resource": "originsevolved:hunter_indicator_ev",
          "comparison": "==",
          "compare_to": 1
        }
      }
    ]
  },
  "falling_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:revoke_power",
        "power": "originsevolved:binding_arrow_ev",
        "source": "originsevolved:sharp_hunter"
      }
    ]
  },
  "condition": {
    "type": "origins:power_active",
    "power": "originsevolved:toggle_bind_disable_ev"
  }
}