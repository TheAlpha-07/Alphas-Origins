{
  "type": "origins:multiple",
  "hidden": true,

  "assassin_attack_resource": {
    "type": "origins:resource",
    "min": 1,
    "max": 2,
    "start_value": 1
  },

  "assassin_attack_toggle": {
    "type": "origins:active_self",
    "hidden": true,
    "key": {
      "key": "key.origins.primary_active"
    },
    "entity_action": {
      "type": "origins:if_else_list",
      "actions": [
        {
          "condition": {
            "type": "origins:resource",
            "resource": "*:*_assassin_attack_resource",
            "comparison": "==",
            "compare_to": 1
          },
          "action": {
            "type": "origins:delay",
            "ticks": 20,
            "action": {
              "type": "origins:change_resource",
              "resource": "*:*_assassin_attack_resource",
              "change": 2,
              "operation": "set"
            }
          }
        },
        {
          "condition": {
            "type": "origins:resource",
            "resource": "*:*_assassin_attack_resource",
            "comparison": "==",
            "compare_to": 2
          },
          "action": {
            "type": "origins:delay",
            "ticks": 20,
            "action": {
              "type": "origins:change_resource",
              "resource": "*:*_assassin_attack_resource",
              "change": 1,
              "operation": "set"
            }
          }
        }
      ]
    }
  },

  "reckless_defensive_resource": {
