            "comparison": "==",
            "compare_to": 1
          },
          "action": {
            "type": "origins:delay",
            "ticks": 20,
            "action": {
              "type": "origins:change_resource",
              "resource": "*:*_reckless_defensive_resource",
              "change": 2,
              "operation": "set"
            }
          }
        },
        {
          "condition": {
            "type": "origins:resource",
            "resource": "*:*_reckless_defensive_resource",
            "comparison": "==",
            "compare_to": 2
          },
          "action": {
            "type": "origins:delay",
            "ticks": 20,
            "action": {
              "type": "origins:change_resource",
