{
  "type": "origins:multiple",

  "blood_sense_change": {
    "type": "origins:toggle",
    "active_by_default": false,
    "key": {
      "key": "key.origins.secondary_active"
    }
  },

  "under_20": {
    "type": "origins:action_on_hit",
    "cooldown": 60,
    "bientity_action": {
      "type": "origins:actor_action",
      "action": {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Target is under 20 HP\", \"color\": \"red\"}"
      }
    },

    "bientity_condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:target_condition",
          "condition": {
            "type": "origins:and",
            "conditions": [
              {
                "type": "origins:health",
                "comparison": "<",
                "compare_to": 20
              },
              {
                "type": "origins:health",
                "comparison": ">=",
                "compare_to": 15
              }
            ]
          }
        },
        {
          "type": "origins:actor_condition",
          "condition": {
            "type": "origins:power_active",
            "power": "*:*_blood_sense_change"
          }
        }
      ]
    }
  },

