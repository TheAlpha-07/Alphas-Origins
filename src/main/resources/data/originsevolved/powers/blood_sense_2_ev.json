{
  "type": "origins:multiple",

  "under_20": {
    "type": "origins:action_on_hit",
    "cooldown": 60,
    "bientity_action": {
      "type": "origins:actor_action",
      "action": {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Target is under 20 HP\", \"color\": \"red\"}"
      }
    },

    "bientity_condition": {
      "type": "origins:target_condition",
      "condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:health",
            "comparison": "<",
            "compare_to": 20
          },
          {
            "type": "origins:health",
            "comparison": ">=",
            "compare_to": 15
          }
        ]
      }
    }
  },

