{
  "type": "origins:action_over_time",
  "interval": 200,

  "rising_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:grant_power",
        "power": "alpha:sense_nightvis",
        "source": "originsevolved:sharp_hunter"
      },
      {
        "type": "origins:grant_power",
        "power": "originsevolved:sense_entity_glow_ev",
        "source": "originsevolved:sharp_hunter"
      },
      {
        "type": "origins:grant_power",
        "power": "alpha:sense_weakness",
        "source": "originsevolved:sharp_hunter"
      },
      {
        "type": "origins:change_resource",
        "resource": "originsevolved:hunter_indicator_ev",
        "change": 4
      },
      {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Attack Mode ACTIVATED\", \"color\": \"red\"}",
        "condition": {
          "type": "origins:resource",
          "resource": "originsevolved:hunter_indicator_ev",
          "comparison": "==",
          "compare_to": 4
        }
      }
    ]
  },
  "falling_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:revoke_power",
        "power": "alpha:sense_nightvis",
        "source": "originsevolved:sharp_hunter"
      },
      {
        "type": "origins:revoke_power",
        "power": "originsevolved:sense_entity_glow_ev",
        "source": "originsevolved:sharp_hunter"
      },
      {
        "type": "origins:revoke_power",
        "power": "alpha:sense_weakness",
        "source": "alpha:hunter"
      }
    ]
  },
  "condition": {
    "type": "origins:power_active",
    "power": "originsevolved:toggle_hunt_sense_ev",
    "inverted": true
  }
}
