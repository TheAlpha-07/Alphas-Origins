{
  "type": "origins:multiple",

  "hit": {
    "type": "origins:modify_damage_dealt",
    "modifier": {
      "operation": "multiply_base_multiplicative",
      "amount": 0.2
    }
  },

  "lose": {
    "type": "origins:self_action_on_hit",
    "entity_action": {
      "type": "origins:revoke_power",
