{
  "type": "origins:multiple",

  "add_resource": {
    "type": "origins:self_action_on_hit",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "originsevolved:targets_ev",
      "change": 1,
      "operation": "add"
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "originsevolved:targets_ev",
          "comparison": "<",
          "compare_to": 5
        }
      ]
    },
    "damage_condition": {
      "type": "origins:amount",
      "comparison": ">=",
      "compare_to": 6
    }
  },

  "hit": {
    "type": "origins:modify_damage_dealt",
    "modifier": {
      "operation": "multiply_total_multiplicative",
      "amount": 0.2
    },
    "condition": {
      "type": "origins:resource",
      "resource": "originsevolved:targets_ev",
      "compare_to": 5,
      "comparison": "=="
    }
  },

  "lose_resource": {
    "type": "origins:self_action_on_hit",
    "interval": 10,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "originsevolved:targets_ev",
      "change": 0,
      "operation": "set"
    },
    "condition": {
      "type": "origins:resource",
      "resource": "originsevolved:targets_ev",
      "compare_to": 5,
      "comparison": "=="
    }
  }
}