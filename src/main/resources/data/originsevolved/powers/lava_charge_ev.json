{
  "type": "origins:multiple",
  "cooldown_resource": {
    "type": "origins:resource",
    "min": 0,
    "max": 20,
    "start_value": 0,
    "hud_render": {
      "should_render": true,
      "sprite_location": "alpha_origins:textures/gui/community/wolf/resource_bar_002.png",
      "bar_index": 0
    }
  },
  "cooldown": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_cooldown_resource",
      "change": 1,
      "operation": "add"
    },
    "interval": 20,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "*:*_cooldown_resource",
          "comparison": "<",
          "compare_to": 20
        }
      ]
    }
  },
  "fire_hands_hit": {
    "type": "origins:action_on_hit",
    "bientity_action": {
      "type": "origins:target_action",
      "action": {
        "type": "origins:set_on_fire",
        "duration": 3
      }
    },
    "bientity_condition": {
      "type": "origins:actor_condition",
      "condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:resource",
            "resource": "originsevolved:lava_charge_resource_ev",
            "comparison": "<=",
            "compare_to": 40
          },
          {
            "type": "origins:resource",
            "resource": "originsevolved:lava_charge_resource_ev",
            "comparison": ">",
            "compare_to": 30
          }
        ]
      }
    }
  },
  "magma_consume": {
    "type": "origins:action_on_block_use",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "*:*_cooldown_resource",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "originsevolved:lava_charge_resource_ev",
          "change": 2
        },
        {
          "type": "origins:set_on_fire",
          "duration": 15
        }
      ]
    },
    "block_action": {
      "type": "origins:set_block",
      "block": "minecraft:blackstone"
    },
    "block_condition": {
      "type": "origins:block",
      "block": "minecraft:magma_block"
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "*:*_cooldown_resource",
          "comparison": "==",
          "compare_to": 20
        },
        {
          "type": "origins:sneaking"
        }
      ]
    }
  }
