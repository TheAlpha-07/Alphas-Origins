            "duration": 40,
            "amplifier": 1
          }
        ]
      },

      "else_action": {
        "type": "origins:apply_effect",
        "effects": [
          {
            "id": "minecraft:resistance",
            "duration": 20,
            "amplifier": 1
          },
          {
            "id": "minecraft:slowness",
            "duration": 40,
            "amplifier": 0
          }
        ]
      }
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:sneaking"
        },
        {
          "type": "origins:resource",
          "resource": "originsevolved:assassin_toggle_rework_ev_reckless_defensive_resource",
          "comparison": "==",
          "compare_to": 2
        }
      ]
    }
  },

  "attack_slow": {
