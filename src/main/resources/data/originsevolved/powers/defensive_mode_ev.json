{
  "type": "origins:multiple",
  "more_hearts": {
    "type": "origins:conditioned_attribute",
    "modifier": {
      "attribute": "minecraft:generic.max_health",
      "value": 2,
      "operation": "addition"
    },
    "condition": {
      "type": "origins:resource",
      "resource": "originsevolved:assassin_toggle_rework_ev_reckless_defensive_resource",
      "comparison": "==",
      "compare_to": 2
    }
  },

  "resistance_sneak": {
    "type": "origins:action_over_time",
    "interval": 5,

    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:exposed_to_sun"
      },

      "if_action": {
        "type": "origins:apply_effect",
        "effects": [
          {
            "effect": "minecraft:resistance",
            "duration": 40,
            "amplifier": 0
          },
          {
            "effect": "minecraft:slowness",
            "duration": 40,
            "amplifier": 1
          }
        ]
      },

      "else_action": {
        "type": "origins:apply_effect",
        "effects": [
          {
            "effect": "minecraft:resistance",
            "duration": 40,
            "amplifier": 1
          },
          {
            "effect": "minecraft:slowness",
            "duration": 40,
            "amplifier": 0
          }
        ]
      }
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:sneaking"
        },
        {
          "type": "origins:resource",
          "resource": "originsevolved:assassin_toggle_rework_ev_reckless_defensive_resource",
          "comparison": "==",
          "compare_to": 2
        }
      ]
    }
  },

  "attack_slow": {
    "type": "origins:conditioned_attribute",
    "modifier": {
      "attribute": "minecraft:generic.attack_speed",
      "value": -0.5,
      "operation": "addition"
    },
    "condition": {
      "type": "origins:resource",
      "resource": "alpha:assassin_toggle_rework_reckless_defensive_resource",
      "comparison": "==",
      "compare_to": 2
    }
  },

  "smash_knockback": {
    "type": "origins:action_on_hit",
    "cooldown": 200,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
      "bar_index": 0
    },

    "bientity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:actor_condition",
        "condition": {
          "type": "origins:resource",
          "resource": "originsevolved:targets_ev",
          "compare_to": 5,
          "comparison": "=="
        }
      },
      "if_action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:add_velocity",
            "z": 1.5
          },
          {
            "type": "origins:actor_action",
            "action": {
              "type": "origins:change_resource",
              "resource": "originsevolved:targets_ev",
              "change": 0,
              "operation": "set"
            }
          }
        ]
      },
      "else_action": {
        "type": "origins:add_velocity",
        "z": 0.5
      }
    },
    "bientity_condition": {
      "type": "origins:actor_condition",
      "condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:sneaking"
          },
          {
            "type": "origins:resource",
            "resource": "originsevolved:assassin_toggle_rework_ev_reckless_defensive_resource",
            "comparison": "==",
            "compare_to": 2
          }
        ]
      }
    }
  },

  "less_kinetic": {
    "type": "origins:modify_damage_taken",
    "modifier": {
      "value": -0.3,
      "operation": "multiply_base"
    },
    "damage_condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:name",
          "name": "fall"
        },
        {
          "type": "origins:name",
          "name": "flyIntoWall"
        }
      ]
    },
    "bientity_condition": {
      "type": "origins:actor_condition",
      "condition": {
        "type": "origins:resource",
        "resource": "originsevolved:assassin_toggle_rework_ev_reckless_defensive_resource",
        "comparison": "==",
        "compare_to": 1
      }
    }
  },

  "message": {
    "type": "origins:action_over_time",
    "interval": 20,
    "rising_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "originsevolved:assassin_indicator_ev",
          "change": 1
        },
        {
          "type": "origins:execute_command",
          "command": "tellraw @s {\"text\": \"Defensive Mode ACTIVATED\", \"color\": \"green\"}",
          "condition": {
            "type": "origins:resource",
            "resource": "originsevolved:assassin_indicator_ev",
            "comparison": "==",
            "compare_to": 2
          }
        }
      ]
    },
    "condition": {
      "type": "origins:resource",
      "resource": "originsevolved:assassin_toggle_rework_ev_reckless_defensive_resource",
      "comparison": "==",
      "compare_to": 2
    }
  }
}