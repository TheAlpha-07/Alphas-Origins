{
  "type": "origins:action_over_time",
  "interval": 200,

  "rising_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:grant_power",
        "power": "alpha:hunt_camouflage",
        "source": "originsevolved:sharp_hunter"
      },
      {
        "type": "origins:grant_power",
        "power": "originsevolved:hunter_entity_glow_ev",
        "source": "originsevolved:sharp_hunter"
      },
      {
        "type": "origins:change_resource",
        "resource": "originsevolved:hunter_indicator_ev",
        "change": 3
      },
      {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Hunting Mode ACTIVATED\", \"color\": \"green\"}",
        "condition": {
          "type": "origins:resource",
          "resource": "originsevolved:hunter_indicator_ev",
          "comparison": "==",
          "compare_to": 3
        }
      }
    ]
  },

  "falling_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:revoke_power",
        "power": "alpha:hunt_camouflage",
        "source": "originsevolved:sharp_hunter"
      },
      {
        "type": "origins:revoke_power",
        "power": "originsevolved:hunter_entity_glow_ev",
        "source": "originsevolved:sharp_hunter"
      }
    ]
  },

  "condition": {
    "type": "origins:resource",
    "resource": "originsevolved:hunt_toggle_rework_ev_hunt_sense_resource",
    "comparison": "==",
    "compare_to": 1
  }
}