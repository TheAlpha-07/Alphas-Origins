{
  "type": "origins:multiple",

  "toggle_ev": {
    "type": "origins:toggle",
    "active_by_default": false,
    "key": {
      "key": "key.origins.denary_active"
    }
  },

  "attackoff": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:revoke_power",
      "power": "originsevolved:attack_entity_glow_ev",
      "source": "originsevolved:sharp_hunter"
    },
    "interval": 5,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "originsevolved:toggle_hunter_ev",
          "inverted": true
        },
        {
          "type": "origins:power_active",
          "power": "*:*_toggle_ev"
        }
      ]
    }
  },

  "attackon": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:grant_power",
      "power": "originsevolved:attack_entity_glow_ev",
      "source": "originsevolved:sharp_hunter"
    },
    "interval": 5,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "originsevolved:toggle_hunter_ev",
          "inverted": true
        },
        {
          "type": "origins:power_active",
          "power": "*:*_toggle_ev",
          "inverted": true
        }
      ]
    }
  },

  "huntoff": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:revoke_power",
      "power": "originsevolved:hunter_entity_glow_ev",
      "source": "originsevolved:sharp_hunter"
    },
    "interval": 5,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "originsevolved:toggle_hunter_ev"
        },
        {
          "type": "origins:power_active",
          "power": "*:*_toggle_ev"
        }
      ]
    }
  },
  "hunton": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:grant_power",
      "power": "originsevolved:hunter_entity_glow_ev",
      "source": "originsevolved:sharp_hunter"
    },
    "interval": 5,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "originsevolved:toggle_hunter_ev"
        },
        {
          "type": "origins:power_active",
          "power": "*:*_toggle_ev",
          "inverted": true
        }
      ]
    }
  }
}