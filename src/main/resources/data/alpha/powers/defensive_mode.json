{
  "type": "origins:multiple",
  "more_hearts": {
    "type": "origins:conditioned_attribute",
    "modifier": {
      "id": "*:*",
      "attribute": "minecraft:generic.max_health",
      "amount": 2,
      "operation": "ADD_VALUE"
    },
    "condition": {
      "type": "origins:resource",
      "resource": "alpha:assassin_toggle_rework_reckless_defensive_resource",
      "comparison": "==",
      "compare_to": 2
    }
  },

  "resistance_sneak": {
    "type": "origins:action_over_time",
    "interval": 5,

    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:exposed_to_sun"
      },

      "if_action": {
        "type": "origins:apply_effect",
        "effects": [
          {
            "id": "minecraft:resistance",
            "duration": 40,
            "amplifier": 0
          },
          {
            "id": "minecraft:slowness",
            "duration": 40,
            "amplifier": 2
          }
        ]
      },

      "else_action": {
        "type": "origins:apply_effect",
        "effects": [
          {
            "id": "minecraft:resistance",
            "duration": 40,
            "amplifier": 0
          },
          {
            "id": "minecraft:slowness",
            "duration": 40,
            "amplifier": 1
          }
        ]
      }
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:sneaking"
        },
        {
          "type": "origins:resource",
          "resource": "alpha:assassin_toggle_rework_reckless_defensive_resource",
          "comparison": "==",
          "compare_to": 2
        }
      ]
    }
  },

  "attack_slow": {
    "type": "origins:conditioned_attribute",
    "modifier": {
      "id": "*:*",
      "attribute": "minecraft:generic.attack_speed",
      "amount": -0.5,
      "operation": "ADD_VALUE"
    },
    "condition": {
      "type": "origins:resource",
      "resource": "alpha:assassin_toggle_rework_reckless_defensive_resource",
      "comparison": "==",
      "compare_to": 2
    }
  },

  "smash_knockback": {
    "type": "origins:action_on_hit",
    "cooldown": 200,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
      "bar_index": 0
    },

    "bientity_action": {
      "type": "origins:add_velocity",
      "z": 0.5
    },
    "bientity_condition": {
      "type": "origins:actor_condition",
      "condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:sneaking"
          },
          {
            "type": "origins:resource",
            "resource": "alpha:assassin_toggle_rework_reckless_defensive_resource",
            "comparison": "==",
            "compare_to": 2
          }
        ]
      }
    }
  },

  "message": {
    "type": "origins:action_over_time",
    "interval": 20,
    "rising_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "alpha:assassin_indicator",
          "change": 1
        },
        {
          "type": "origins:execute_command",
          "command": "tellraw @s {\"text\": \"Defensive Mode ACTIVATED\", \"color\": \"green\"}",
          "condition": {
            "type": "origins:resource",
            "resource": "alpha:assassin_indicator",
            "comparison": "==",
            "compare_to": 2
          }
        }
      ]
    },
    "condition": {
      "type": "origins:resource",
      "resource": "alpha:assassin_toggle_rework_reckless_defensive_resource",
      "comparison": "==",
      "compare_to": 2
    }
  }
}
