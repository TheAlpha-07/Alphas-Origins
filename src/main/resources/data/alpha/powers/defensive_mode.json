{
  "type": "origins:action_over_time",
  "interval": 20,

  "rising_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:grant_power",
        "power": "alpha:more_hearts",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:grant_power",
        "power": "alpha:resistance_sneak",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:grant_power",
        "power": "alpha:smash_knockback",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:grant_power",
        "power": "alpha:attack_slow",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:change_resource",
        "resource": "alpha:assassin_indicator",
        "change": 2
      },
      {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Defensive Mode ACTIVATED\", \"color\": \"green\"}",
        "condition": {
          "type": "origins:resource",
          "resource": "alpha:assassin_indicator",
          "comparison": "==",
          "compare_to": 2
        }
      }
    ]
  },
  "falling_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:revoke_power",
        "power": "alpha:more_hearts",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:revoke_power",
        "power": "alpha:resistance_sneak",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:revoke_power",
        "power": "alpha:smash_knockback",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:revoke_power",
        "power": "alpha:attack_slow",
        "source": "alpha:assassin"
      }
    ]
  },

  "condition": {
    "type": "origins:power_active",
    "power": "alpha:toggle_reckless_defensive",
    "inverted": true
  }
}