{
  "type": "origins:action_over_time",
  "interval": 200,
  "rising_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:grant_power",
        "power": "alpha:venomous_arrow",
        "source": "alpha:hunter"
      },
      {
        "type": "origins:change_resource",
        "resource": "alpha:hunter_indicator",
        "change": 2
      },
      {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Disable Mode ACTIVATED\", \"color\": \"green\"}",
        "condition": {
          "type": "origins:resource",
          "resource": "alpha:hunter_indicator",
          "comparison": "==",
          "compare_to": 2
        }
      }
    ]
  },
  "falling_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:revoke_power",
        "power": "alpha:venomous_arrow",
        "source": "alpha:hunter"
      }
    ]
  },
  "condition": {
    "type": "origins:power_active",
    "power": "alpha:toggle_bind_disable",
    "inverted": true
  }
}