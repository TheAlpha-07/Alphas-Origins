{
  "type": "origins:action_over_time",
  "interval": 200,

  "rising_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:grant_power",
        "power": "alpha:less_hearts",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:grant_power",
        "power": "alpha:dash",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:grant_power",
        "power": "alpha:no_shield",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:grant_power",
        "power": "alpha:attack_speed",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:change_resource",
        "resource": "alpha:assassin_indicator",
        "change": 1
      },
      {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Reckless Mode ACTIVATED\", \"color\": \"green\"}",
        "condition": {
          "type": "origins:resource",
          "resource": "alpha:assassin_indicator",
          "comparison": "==",
          "compare_to": 1
        }
      }
    ]
  },
  "falling_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:revoke_power",
        "power": "alpha:less_hearts",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:revoke_power",
        "power": "alpha:dash",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:revoke_power",
        "power": "alpha:no_shield",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:revoke_power",
        "power": "alpha:attack_speed",
        "source": "alpha:assassin"
      }
    ]
  },
  "condition": {
    "type": "origins:power_active",
    "power": "alpha:toggle_reckless_defensive"
  }
}