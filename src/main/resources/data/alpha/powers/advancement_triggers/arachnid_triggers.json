{
  "type": "origins:multiple",

  "climbing": {
    "hidden": true,
    "type": "origins:action_over_time",
    "rising_action": {
      "type": "origins:execute_command",
      "command": "advancement grant @s only alphasorigins:arachnid/climbing"
    },
    "interval": 20,

    "condition": {
      "type": "origins:climbing"
    }
  },

  "webbed_touch": {
    "hidden": true,
    "type": "origins:action_on_hit",
    "bientity_action": {
      "type": "origins:actor_action",
      "action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:execute_command",
            "command": "advancement grant @s only alphasorigins:arachnid/master_of_webs"
          },
          {
            "type": "origins:execute_command",
            "command": "advancement grant @s only alphasorigins:arachnid/webbed_touch"
          }
        ]
      }
    }
  },

  "webbed_walk": {
    "hidden": true,
    "type": "origins:action_over_time",
    "rising_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "advancement grant @s only alphasorigins:arachnid/master_of_webs"
        },
        {
          "type": "origins:execute_command",
          "command": "advancement grant @s only alphasorigins:arachnid/webbed_walk"
        }
      ]
    },
    "interval": 20,

    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:in_block",
          "block_condition": {
            "type": "origins:block",
            "block": "minecraft:cobweb"
          }
        },
        {
          "type": "origins:moving"
        }
      ]
    }
  },

  "webbed_craft": {
    "hidden": true,
    "type": "origins:action_over_time",
    "rising_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "advancement grant @s only alphasorigins:arachnid/master_of_webs"
        },
        {
          "type": "origins:execute_command",
          "command": "advancement grant @s only alphasorigins:arachnid/webbed_craft"
        }
      ]
    },
    "interval": 20,

    "condition": {
      "type": "origins:inventory",
      "process_mode": "items",
      "item_condition": {
        "type": "origins:ingredient",
        "ingredient": {
          "tag": "minecraft:cobweb"
        }
      }
    }
  }
}