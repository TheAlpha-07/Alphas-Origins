{
  "type": "origins:multiple",

  "attacktoggle": {
    "type": "origins:toggle",
    "active_by_default": false,
    "key": {
      "key": "key.origins.denary_active"
    }
  },

  "attackoff": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:revoke_power",
      "power": "alpha:attack_entity_glow",
      "source": "alpha:hunter"
    },
    "interval": 5,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "alpha:toggle_hunt_attack",
          "inverted": true
        },
        {
          "type": "origins:power_active",
          "power": "*:*_attacktoggle"
        }
      ]
    }
  },

  "attackon": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:grant_power",
      "power": "alpha:attack_entity_glow",
      "source": "alpha:hunter"
    },
    "interval": 5,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "alpha:toggle_hunt_attack",
          "inverted": true
        },
        {
          "type": "origins:power_active",
          "power": "*:*_attacktoggle",
          "inverted": true
        }
      ]
    }
  },

  "huntoff": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:revoke_power",
      "power": "alpha:hunter_entity_glow",
      "source": "alpha:hunter"
    },
    "interval": 5,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "alpha:toggle_hunt_attack"
        },
        {
          "type": "origins:power_active",
          "power": "*:*_attacktoggle"
        }
      ]
    }
  },

  "hunton": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:grant_power",
      "power": "alpha:hunter_entity_glow",
      "source": "alpha:hunter"
    },
    "interval": 5,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "alpha:toggle_hunt_attack"
        },
        {
          "type": "origins:power_active",
          "power": "*:*_attacktoggle",
          "inverted": true
        }
      ]
    }
  }
