{
  "type": "origins:action_over_time",
  "interval": 20,

  "rising_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:grant_power",
        "power": "alpha:hunt_camouflage",
        "source": "alpha:hunter"
      },
      {
        "type": "origins:grant_power",
        "power": "alpha:hunter_entity_glow",
        "source": "alpha:hunter"
      },
      {
        "type": "origins:change_resource",
        "resource": "alpha:assassin_indicator",
        "change": 3
      },
      {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Hunting Mode ACTIVATED\", \"color\": \"red\"}",
        "condition": {
          "type": "origins:resource",
          "resource": "alpha:hunter_indicator",
          "comparison": "==",
          "compare_to": 3
        }
      }
    ]
  },
  "falling_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:revoke_power",
        "power": "alpha:hunt_camouflage",
        "source": "alpha:hunter"
      },
      {
        "type": "origins:revoke_power",
        "power": "alpha:hunter_entity_glow",
        "source": "alpha:hunter"
      }
    ]
  },
  "condition": {
    "type": "origins:power_active",
    "power": "alpha:toggle_hunt_attack"
  }
}