{
  "type": "origins:action_over_time",
  "interval": 5,

  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:exposed_to_sun"
    },

    "if_action": {
      "type": "origins:apply_effect",
      "effects": [
        {
          "effect": "minecraft:resistance",
          "duration": 40,
          "amplifier": 1
        },
        {
          "effect": "minecraft:slowness",
          "duration": 40,
          "amplifier": 1
        }
      ]
    },

    "else_action": {
      "type": "origins:apply_effect",
      "effects": [
        {
          "effect": "minecraft:resistance",
          "duration": 40,
          "amplifier": 0
        },
        {
          "effect": "minecraft:slowness",
          "duration": 40,
          "amplifier": 1
        }
      ]
    }
  },
  "condition": {
    "type": "origins:sneaking"
  }
}