{
  "type": "origins:action_over_time",
  "interval": 200,

  "badges": [
    {
      "sprite": "origins:textures/gui/badge/info.png",
      "text": "The ultimate poison against the undead."
    }
  ],

  "rising_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:grant_power",
        "power": "alpha:known_monsters",
        "source": "alpha:assassin"
      },
      {
        "type": "origins:change_resource",
        "resource": "alpha:assassin_indicator",
        "change": 4
      },
      {
        "type": "origins:execute_command",
        "command": "tellraw @s {\"text\": \"Monster Mode ACTIVATED\", \"color\": \"red\"}",
        "condition": {
          "type": "origins:resource",
          "resource": "alpha:assassin_indicator",
          "comparison": "==",
          "compare_to": 4
        }
      }
    ]
  },
  "falling_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:revoke_power",
        "power": "alpha:known_monsters",
        "source": "alpha:assassin"
      }
    ]
  },

  "condition": {
    "type": "origins:resource",
    "resource": "alpha:assassin_toggle_rework_assassin_attack_resource",
    "comparison": "==",
    "compare_to": 2
  }
}