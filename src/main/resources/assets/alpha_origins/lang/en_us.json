  "origin.originsevolved.blazeborn_evolved.name": "Blazeborn Evolved",
  "origin.originsevolved.blazeborn_evolved.description": "After killing the Beast of the End you feel a part of the End magic combine with your Nether magic. This power feels strong and powerful like pure fire, this power makes you evolve into an Evolved Blazeborn.",

  "power.originsevolved.inferno_ev.name": "Inferno",
