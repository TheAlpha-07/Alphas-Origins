  "power.originsevolved.muscle_power.name": "Speed of the Wind",
  "power.originsevolved.muscle_power.description": "You can use the wind to increase your speed, but because of your lack of wind magic your power will drain while using it giving you slowness afterwards.",

  "power.originsevolved.hurtfull_feathers_ev.name": "Bloody Feathers",
  "power.originsevolved.hurtfull_feathers_ev.description": "test",

