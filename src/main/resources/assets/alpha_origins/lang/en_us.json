  "power.originsevolved.cold_body_ev.name": "Cold Body",
  "power.originsevolved.cold_body_ev.description": "You're a purer form of the blaze you once were, you need to keep your body warmth once in a while.",

  "power.originsevolved.cold_body_effects_ev.name": "Cold Body test",
  "power.originsevolved.cold_body_effects_ev.description": "test",


