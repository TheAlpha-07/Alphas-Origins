  "power.originsevolved.arrow_immunity_ev.name": "Arrow Immunity",
  "power.originsevolved.arrow_immunity_ev.description": "Now that you've evolved into a stronger version of yourself, you're more like a real enderman. Now no arrows can hit you.",

  "power.originsevolved.eyes_of_the_end_ev.name": "Ender Eyes",
  "power.originsevolved.eyes_of_the_end_ev.description": "Your already good eyes got even better, even though you are now more like an enderman, even normal enderman can't see this good. You are now able to see your enemies from afar and see through the night.",

  "power.originsevolved.no_water_ev.name": "No Water",
