  "power.originsevolved.medium_armor_ev.name": "Need For Mobility+",
  "power.originsevolved.medium_armor_ev.description": "You are able to wear slightly heavier armor now, with the value of iron and a diamond helmet.",

  "power.originsevolved.less_kinetic_damage_ev.name": "Less Kinetic Damage",
