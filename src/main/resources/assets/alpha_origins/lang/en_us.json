  "power.originsevolved.sneaky_ev.name": "Jumpscare",
  "power.originsevolved.sneaky_ev.description": "After some experiments and drinking all sorts of poisons, this end magic was the last ingredient to this magnificent power, you're able to make others feel your existence when you're phantomized, you can do this whenever you want to making others scared whenever doing this.",

  "power.originsevolved.hell_fire_ev.name": "Hell Fire",
  "power.originsevolved.hell_fire_ev.description": "Fire 2x damage",

