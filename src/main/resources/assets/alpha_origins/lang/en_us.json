  "power.originsevolved.summon_cave_spider_ev.name": "Their leader",
  "power.originsevolved.summon_cave_spider_ev.description": "All spiders are passive towards you unless you hit them. You can now even summon 4 cave spiders to make them fight for you and protect yourself.",

  "power.originsevolved.prey_ev.name": "Prey the weak.",
  "power.originsevolved.prey_ev.description": "Only the strongest can survive.",

  "power.originsevolved.more_health_arach_ev.name": "Less fragile",
  "power.originsevolved.more_health_arach_ev.description": "Not only your extincts have grown better, so did your body, you're now able to withstand more damage than before.",

  "power.originsevolved.carnivore_ev.name": "Carnivore+",
  "power.originsevolved.carnivore_ev.description": "Now that you've evolved the ends magic allows you to eat magic itself, in fact, golden apples, enchanted golden apples and other are seen as food that gives you magical buffs.",

  "power.originsevolved.friend_or_foe_ev.name": "Friend or Foe",
  "power.originsevolved.friend_or_foe_ev.description": "As a hunter you're way more flexible and deadly at night, but in daytime you're weak and vulnerable",

  // Avian

  // Avian Evolved
  "origin.originsevolved.avian_evolved.name": "Avian Evolved",
  "origin.originsevolved.avian_evolved.description": "You killed the Ender Dragon, the Beast of the Sky, you feel pride upon your heart making you evolve into an Evolved Avian",

  "power.originsevolved.absolute_velocity.name": "Absolute Velocity",
  "power.originsevolved.absolute_velocity.description": "As you sprint, your velocity bar increases. The higher the velocity bar the more movement speed you gain. At maximum movement speed, you take no knockback and will knock up anyone that damages you. Velocity will rapidly decrease while not sprinting.",

  "power.originsevolved.gain_air_ev.name": "Leap of Faith",
